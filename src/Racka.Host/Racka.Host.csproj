<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>racka</AssemblyName>
        <RootNamespace>Racka.Host</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Every agent is its own process: workstation GC keeps each one small (the Web SDK defaults to server GC). -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

    <!-- dotnet tool: dotnet tool install -g Racka -->
    <PropertyGroup>
        <!-- The Web SDK turns packing off by default. -->
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>racka</ToolCommandName>
        <PackageId>Racka</PackageId>
        <Authors>David Kozma</Authors>
        <Description>Multi-agent framework on .NET: agents on Claude Code, Codex, the Claude API or OpenAI-compatible/local models talk to each other and hand off tasks over a local bus.</Description>
        <PackageTags>agents;multi-agent;llm;claude;claude-code;codex;openai;ollama;mcp;cli</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/k0zi/Sheep</RepositoryUrl>
        <PackageProjectUrl>https://github.com/k0zi/Sheep</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Racka.Core\Racka.Core.csproj" />
        <ProjectReference Include="..\Racka.Providers\Racka.Providers.csproj" />
        <ProjectReference Include="..\Racka.Irc\Racka.Irc.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.15" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Racka.Tests" />
    </ItemGroup>

</Project>
